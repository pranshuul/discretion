{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "additionalProperties": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "capabilities": {
                "items": {
                  "enum": [
                    "vault.write",
                    "message.send",
                    "mail.send",
                    "network"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "exit": {
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
                },
                "type": "object"
              },
              "kind": {
                "const": "script",
                "type": "string"
              },
              "max_attempts": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "on": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "run": {
                "type": "string"
              },
              "timeout": {
                "exclusiveMinimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "run",
              "exit",
              "on"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "end",
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "outcome"
            ],
            "type": "object"
          }
        ]
      },
      "type": "object"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "const": "runflow/1",
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "schema",
        "start"
      ],
      "type": "object"
    }
  },
  "required": [
    "workflow",
    "nodes"
  ],
  "title": "runflow/1",
  "type": "object"
}
