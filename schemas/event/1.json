{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "pattern": "^cap_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$",
      "type": "string"
    },
    "data": {
      "additionalProperties": {},
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "source",
    "data"
  ],
  "title": "event/1",
  "type": "object"
}
