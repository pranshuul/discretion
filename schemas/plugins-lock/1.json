{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "plugins": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "additionalProperties": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "propertyNames": {
              "minLength": 1
            },
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "repo": {
            "pattern": "^[^/\\s]+\\/[^/\\s]+$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "repo",
          "version",
          "files"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "plugins-lock/1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plugins"
  ],
  "title": "plugins-lock/1",
  "type": "object"
}
