{
  "name": "discretion",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "test": "tsc -b && vitest run",
    "schemas:check": "pnpm -r --if-present run schemas:check"
  },
  "devDependencies": {
    "@discretion/cli": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
